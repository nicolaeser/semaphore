# --- Postgres ---
POSTGRES_USER=semaphore
POSTGRES_PASSWORD=dont-use-me-in-production
POSTGRES_DB=semaphore

# --- Semaphore image ---
SEMAPHORE_VERSION=v2.19.12
SEMAPHORE_PORT=3000

# --- Semaphore database connection ---
SEMAPHORE_DB_DIALECT=postgres
SEMAPHORE_DB_HOST=db

# --- Semaphore admin user ---
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=this-should-be-changed-before-use
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@this-is-just-an-example-dont-use-it-in-prod.net

# --- Runner / alerts ---
SEMAPHORE_USE_REMOTE_RUNNER=True
SEMAPHORE_MICROSOFT_TEAMS_ALERT=True
SEMAPHORE_MICROSOFT_TEAMS_URL=https://your-teams-webhook-url
